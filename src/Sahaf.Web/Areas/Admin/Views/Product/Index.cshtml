@model AdminListVM<Product>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = T["nav.products"];
    var english = Culture.IsEnglish;
    var categories = (List<SelectListItem>)ViewBag.Categories;

    string Link(int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(Model.Query)) parts.Add("q=" + Uri.EscapeDataString(Model.Query));
        if (Model.CategoryId.HasValue) parts.Add("categoryId=" + Model.CategoryId);
        if (page > 1) parts.Add("page=" + page);
        return "/Admin/Product" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
}
<partial name="_AdminNav" />
<header class="admin-head">
    <h1>@T["nav.products"] <span class="muted small">(@Model.TotalCount)</span></h1>
    <a class="btn btn--small" href="/Admin/Product/Upsert">+ @T["admin.newProduct"]</a>
</header>

<form method="get" class="filter-bar">
    <label class="sr-only" for="pq">@T["nav.search"]</label>
    <input id="pq" name="q" type="search" maxlength="80" value="@Model.Query" placeholder="@T["nav.searchPlaceholder"]" />
    <label class="sr-only" for="pc">@T["field.category"]</label>
    <select id="pc" name="categoryId">
        <option value="">@T["catalog.all"]</option>
        @foreach (var c in categories)
        {
            <option value="@c.Value" selected="@(c.Value == Model.CategoryId?.ToString())">@c.Text</option>
        }
    </select>
    <button class="btn btn--small" type="submit">@T["catalog.apply"]</button>
</form>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th scope="col"><span class="sr-only">@T["admin.cover"]</span></th>
                <th scope="col">@T["field.title"]</th>
                <th scope="col">@T["field.category"]</th>
                <th scope="col" class="num">@T["field.listPrice"]</th>
                <th scope="col" class="num">@T["field.price"]</th>
                <th scope="col"><span class="sr-only">@T["admin.actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td><img class="table__cover" src="@Covers.Url(p)" alt="" width="36" height="54" loading="lazy" /></td>
                    <td>
                        <strong>@p.Title</strong> @if (p.IsFeatured) { <span class="tag">@T["admin.featured"]</span> }
                        <div class="muted small">@p.Author</div>
                    </td>
                    <td>@p.Category.LocalName(english)</td>
                    <td class="num mono">@Culture.Money(p.ListPrice)</td>
                    <td class="num mono">@Culture.Money(p.Price)</td>
                    <td class="actions">
                        <a href="/Admin/Product/Upsert/@p.Id">@T["admin.edit"]</a>
                        <form method="post" action="/Admin/Product/Delete/@p.Id" data-confirm="@T["admin.confirmDelete", p.Title]">
                            @Html.AntiForgeryToken()
                            <button class="link-btn" type="submit">@T["admin.delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pagination" model="(Model.Page, Model.TotalPages, (Func<int, string>)Link)" />
