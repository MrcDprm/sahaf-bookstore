@model List<Company>
@{
    ViewData["Title"] = T["nav.companies"];
    var counts = (Dictionary<int, int>)ViewBag.Counts;
}
<partial name="_AdminNav" />
<header class="admin-head">
    <h1>@T["nav.companies"]</h1>
    <a class="btn btn--small" href="/Admin/Company/Upsert">+ @T["admin.newCompany"]</a>
</header>

@if (Model.Count == 0)
{
    <p class="muted">@T["admin.empty"]</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@T["field.companyName"]</th>
                    <th scope="col">@T["field.city"]</th>
                    <th scope="col">@T["field.phone"]</th>
                    <th scope="col" class="num">@T["nav.users"]</th>
                    <th scope="col"><span class="sr-only">@T["admin.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Name</strong></td>
                        <td>@c.City @(string.IsNullOrEmpty(c.State) ? "" : "/ " + c.State)</td>
                        <td class="mono">@c.PhoneNumber</td>
                        <td class="num">@counts.GetValueOrDefault(c.Id)</td>
                        <td class="actions">
                            <a href="/Admin/Company/Upsert/@c.Id">@T["admin.edit"]</a>
                            <form method="post" action="/Admin/Company/Delete/@c.Id" data-confirm="@T["admin.confirmDelete", c.Name]">
                                @Html.AntiForgeryToken()
                                <button class="link-btn" type="submit">@T["admin.delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
