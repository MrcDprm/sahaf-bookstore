@model List<Category>
@{
    ViewData["Title"] = T["nav.categories"];
    var counts = (Dictionary<int, int>)ViewBag.Counts;
}
<partial name="_AdminNav" />
<header class="admin-head">
    <h1>@T["nav.categories"]</h1>
    <a class="btn btn--small" href="/Admin/Category/Upsert">+ @T["admin.newCategory"]</a>
</header>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th scope="col">@T["field.displayOrder"]</th>
                <th scope="col">@T["field.name"]</th>
                <th scope="col">@T["field.nameEn"]</th>
                <th scope="col" class="num">@T["nav.products"]</th>
                <th scope="col"><span class="sr-only">@T["admin.actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="mono">@c.DisplayOrder</td>
                    <td><strong>@c.Name</strong></td>
                    <td>@c.NameEn</td>
                    <td class="num">@counts.GetValueOrDefault(c.Id)</td>
                    <td class="actions">
                        <a href="/Admin/Category/Upsert/@c.Id">@T["admin.edit"]</a>
                        <form method="post" action="/Admin/Category/Delete/@c.Id" data-confirm="@T["admin.confirmDelete", c.Name]">
                            @Html.AntiForgeryToken()
                            <button class="link-btn" type="submit">@T["admin.delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
