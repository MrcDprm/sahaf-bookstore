@{
    ViewData["Title"] = T["about.title"];
}
<article class="prose">
    <p class="eyebrow">@T["about.eyebrow"]</p>
    <h1 class="display display--md">@T["about.title"]</h1>
    <p class="lead">@T["about.lead"]</p>

    <h2>@T["about.demoTitle"]</h2>
    <p>@T["about.demoText"]</p>
    <ul>
        <li>@T["about.demoCard"] <code>4242 4242 4242 4242</code></li>
        <li>@T["about.demoExpiry"]</li>
        <li>@T["about.demoSleep"]</li>
    </ul>

    <h2>@T["about.seriesTitle"]</h2>
    <p>@T["about.seriesText"]</p>

    <h2>@T["about.techTitle"]</h2>
    <p>@T["about.techText"]</p>

    <h2>@T["about.privacyTitle"]</h2>
    <p>@T["about.privacyText"]</p>
</article>
