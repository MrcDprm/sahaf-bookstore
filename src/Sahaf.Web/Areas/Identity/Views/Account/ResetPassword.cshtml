@model ResetPasswordVM
@{
    ViewData["Title"] = T["account.resetTitle"];
}
<section class="auth__card auth__card--solo">
    <h1>@T["account.resetTitle"]</h1>
    <form method="post" class="form" novalidate>
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        <input type="hidden" asp-for="Code" />
        <field asp-for="Email" type="email" autocomplete="email" />
        <field asp-for="Password" type="password" autocomplete="new-password" hint="@T["account.passwordHint"]" />
        <field asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <button class="btn btn--wide" type="submit">@T["account.resetTitle"]</button>
    </form>
</section>
