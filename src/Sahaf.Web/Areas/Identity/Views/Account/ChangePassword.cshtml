@model ChangePasswordVM
@{
    ViewData["Title"] = T["account.changePassword"];
}
<div class="page-narrow">
    <h1>@T["nav.account"]</h1>
    <partial name="_AccountNav" />
    <form method="post" class="form panel" novalidate>
        <field asp-for="OldPassword" type="password" autocomplete="current-password" />
        <field asp-for="NewPassword" type="password" autocomplete="new-password" hint="@T["account.passwordHint"]" />
        <field asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <button class="btn" type="submit">@T["account.changePassword"]</button>
    </form>
</div>
