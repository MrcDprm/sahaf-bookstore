@using Sahaf.Web.Infrastructure
@{
    var english = Culture.IsEnglish;
    var path = Context.Request.Path + Context.Request.QueryString;
    var title = ViewData["Title"] as string ?? ViewData["Title"]?.ToString();
}
<!DOCTYPE html>
<html lang="@(english ? "en" : "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? "Sahaf" : title + " · Sahaf")</title>
    <meta name="description" content="@T["meta.description"]" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..600&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main">@T["nav.skip"]</a>

    <div class="demo-bar">
        <span>@T["demo.bar"]</span>
        <code>4242 4242 4242 4242</code>
    </div>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" href="/" aria-label="Sahaf">
                <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true"><use href="/favicon.svg#mark" /></svg>
                <span class="brand__name">Sahaf</span>
            </a>

            <form class="search" method="get" action="/Customer/Home/Catalog" role="search">
                <label class="sr-only" for="q">@T["nav.search"]</label>
                <input id="q" name="q" type="search" maxlength="80" placeholder="@T["nav.searchPlaceholder"]" value="@Context.Request.Query["q"]" />
                <button type="submit" aria-label="@T["nav.search"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                </button>
            </form>

            <nav class="main-nav" aria-label="@T["nav.main"]">
                <a href="/Customer/Home/Catalog">@T["nav.catalog"]</a>
                <a href="/Customer/Home/About">@T["nav.about"]</a>
                @if (User.IsStaff())
                {
                    <details class="menu">
                        <summary>@T["nav.admin"]</summary>
                        <div class="menu__panel">
                            <a href="/Admin/Order">@T["nav.orders"]</a>
                            @if (User.IsInRole(SD.Role_Admin))
                            {
                                <a href="/Admin/Product">@T["nav.products"]</a>
                                <a href="/Admin/Category">@T["nav.categories"]</a>
                                <a href="/Admin/Company">@T["nav.companies"]</a>
                                <a href="/Admin/User">@T["nav.users"]</a>
                            }
                        </div>
                    </details>
                }
            </nav>

            <div class="toolbar">
                <a class="icon-btn lang" href="/lang/@(english ? "tr" : "en")?returnUrl=@Uri.EscapeDataString(path)"
                   lang="@(english ? "tr" : "en")" aria-label="@T["nav.language"]">@(english ? "TR" : "EN")</a>
                <button class="icon-btn" type="button" data-theme-toggle aria-label="@T["nav.theme"]">
                    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
                    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
                <a class="icon-btn cart-btn" href="/Customer/Cart" aria-label="@T["nav.cart"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h2l1.6 10.2a2 2 0 0 0 2 1.8h6.6a2 2 0 0 0 2-1.6L20.5 8H7.4" /><circle cx="10" cy="20" r="1.4" /><circle cx="17" cy="20" r="1.4" /></svg>
                    @await Component.InvokeAsync("CartCount")
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <details class="menu menu--right">
                        <summary class="icon-btn" aria-label="@T["nav.account"]">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                        </summary>
                        <div class="menu__panel">
                            <span class="menu__label">@User.Identity.Name</span>
                            <a href="/Admin/Order">@T["nav.myOrders"]</a>
                            <a href="/Identity/Account/Manage">@T["nav.profile"]</a>
                            <form method="post" action="/Identity/Account/Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit">@T["nav.logout"]</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a class="btn btn--small" href="/Identity/Account/Login">@T["nav.login"]</a>
                }
            </div>
        </div>
    </header>

    <div class="toasts" aria-live="polite">
        @if (TempData["success"] is string ok)
        {
            <div class="toast toast--ok" role="status">@ok</div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="toast toast--error" role="alert">@err</div>
        }
    </div>

    <main id="main" class="container main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <div>
                <a class="brand brand--footer" href="/">
                    <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true"><use href="/favicon.svg#mark" /></svg>
                    <span class="brand__name">Sahaf</span>
                </a>
                <p class="muted">@T["footer.tagline"]</p>
            </div>
            <nav class="footer-links" aria-label="@T["footer.links"]">
                <a href="/Customer/Home/Catalog">@T["nav.catalog"]</a>
                <a href="/Customer/Home/About">@T["nav.about"]</a>
                <a href="https://github.com/MrcDprm/sahaf-bookstore" rel="noopener">GitHub</a>
                <a href="https://www.miracdeprem.com" rel="noopener">miracdeprem.com</a>
            </nav>
            <p class="muted small">@T["footer.note"]</p>
        </div>
    </footer>
</body>
</html>
