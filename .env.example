# Environment variables Sahaf reads in production (set them in the Render
# dashboard, never commit real values). "__" is how .NET maps nested settings,
# e.g. Stripe__SecretKey -> Stripe:SecretKey.

# Postgres connection; a Neon URI (postgresql://...) works as is.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# First admin account, created on startup if it does not exist yet.
# Password: at least 10 characters with upper case, lower case and a digit.
Admin__Email=admin@example.com
Admin__Password=

# Stripe test mode keys (Developers > API keys / Webhooks).
Stripe__SecretKey=sk_test_
Stripe__WebhookSecret=whsec_

# Resend API key and a sender on a verified domain.
Email__ResendApiKey=re_
Email__From=Sahaf <no-reply@example.com>

# Host names the app answers to.
AllowedHosts=localhost
